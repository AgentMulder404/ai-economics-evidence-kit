{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evidence-kit:0.1:Customer",
  "title": "Customer",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "type": {
      "const": "Customer"
    },
    "schema_version": {
      "const": "0.1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "required": [
    "id",
    "schema_version",
    "type"
  ],
  "additionalProperties": false
}
