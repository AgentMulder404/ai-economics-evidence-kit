{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:evidence-kit:0.1:Recommendation",
  "title": "Recommendation",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "type": {
      "const": "Recommendation"
    },
    "schema_version": {
      "const": "0.1"
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "proposed_action": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "READY",
        "HELD"
      ]
    },
    "hold_reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  },
  "required": [
    "evidence_ids",
    "finding_ids",
    "hold_reasons",
    "id",
    "policy_version",
    "proposed_action",
    "rationale",
    "schema_version",
    "status",
    "type"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "HELD"
          }
        }
      },
      "then": {
        "properties": {
          "hold_reasons": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "hold_reasons": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
